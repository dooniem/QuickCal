<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <!-- .NET 10 (LTS) - comes with Visual Studio 2026 -->
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <!-- Windows Forms is only used for the notification-area (tray) icon -->
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>disable</ImplicitUsings>
    <Nullable>disable</Nullable>
    <LangVersion>latest</LangVersion>
    <!-- WFO0003 is a Windows Forms hint. QuickCal is a WPF app, and WPF reads its DPI settings
         from app.manifest, so the manifest settings must stay. -->
    <NoWarn>$(NoWarn);WFO0003</NoWarn>

    <RootNamespace>QuickCal</RootNamespace>
    <AssemblyName>QuickCal</AssemblyName>
    <ApplicationIcon>Assets\QuickCal.ico</ApplicationIcon>
    <ApplicationManifest>app.manifest</ApplicationManifest>

    <Product>QuickCal</Product>
    <Company>dooniem</Company>
    <Authors>Magnus Petersen</Authors>
    <Description>Quick ISO week calendar with Norwegian vacation display</Description>
    <Version>2.0.0</Version>

    <!-- Portable: one self-contained .exe, no .NET installation needed on the target PC -->
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
    <DebugType>embedded</DebugType>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
  </PropertyGroup>

  <ItemGroup>
    <Resource Include="Assets\gold_texture.jpg" />
    <Resource Include="Assets\QuickCal.ico" />
  </ItemGroup>

</Project>
